# Ambiente da aplicação
APP_ENV=development

# HTTP server
HTTP_PORT=8080
HTTP_MODE=release

# PostgreSQL
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=orderflow
DB_SSLMODE=disable

# Kafka
MESSAGING_BROKER=localhost:9092
MESSAGING_CLIENT_ID=order-service
MESSAGING_WRITE_TIMEOUT=5s
